#!/usr/bin/env bash
set -euo pipefail

cell_home() {
  local project_root="$1" hash
  hash="$(printf '%s' "${project_root}" | shasum -a 256 | cut -c1-12)"
  echo "${CLAUDETANAMO_HOME:-${HOME}/Library/Application Support/claudetanamo}/projects/$(basename "${project_root}")-${hash}"
}

SOURCE_BIN="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_BIN" ]]; do
  BIN_DIR="$(cd -P "$(dirname "$SOURCE_BIN")" && pwd)"
  SOURCE_BIN="$(readlink "$SOURCE_BIN")"
  [[ $SOURCE_BIN != /* ]] && SOURCE_BIN="$BIN_DIR/$SOURCE_BIN"
done
CLAUDETANAMO_REPO="$(cd -P "$(dirname "$SOURCE_BIN")/.." && pwd)"
DEFAULTS_DIR="${CLAUDETANAMO_REPO}/defaults"

PROJECT_ROOT="$(pwd)"
JAIL_DATA_DIR="${PROJECT_ROOT}/.claudetanamo"
CELL_HOME="$(cell_home "$(pwd -P)")"
STATE_DIR="${CELL_HOME}/state"
WORK_DIR="${CELL_HOME}/workspace"
IMAGE_TAG="claudetanamo:latest"

if [[ "${1:-}" == "--fetch" ]]; then
  if [[ ! -d "${WORK_DIR}" ]]; then
    echo "[-] No cell workspace for this project yet" >&2
    exit 1
  fi
  git -c fetch.fsckObjects=true fetch --no-tags --no-recurse-submodules --prune \
    "${WORK_DIR}" '+refs/heads/claude/*:refs/remotes/cell/claude/*'
  git branch -r --list 'cell/claude/*'
  exit 0
fi

# state used to live in the project, where backups and cloud sync pick up the credentials
if [[ -d "${JAIL_DATA_DIR}/state" && ! -L "${JAIL_DATA_DIR}/state" && ! -e "${STATE_DIR}" ]]; then
  echo "[+] Moving session state to ${STATE_DIR}..."
  mkdir -p "${CELL_HOME}"
  mv "${JAIL_DATA_DIR}/state" "${STATE_DIR}"
fi

# the cell can write anywhere under its state dir, so a symlink there could
# point the copies below at any host path
if [[ -n "$(find "${STATE_DIR}" -type l -print -quit 2>/dev/null)" ]]; then
  echo "[-] Symlink found under ${STATE_DIR}, refusing to start:" >&2
  find "${STATE_DIR}" -type l >&2
  exit 1
fi

mkdir -p "${STATE_DIR}/skills"
chmod 700 "${CELL_HOME}"

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  GIT_DIR="$(git rev-parse --git-dir)"
  EXCLUDE_FILE="${GIT_DIR}/info/exclude"
  mkdir -p "$(dirname "${EXCLUDE_FILE}")"
  if [[ -L "$(dirname "${EXCLUDE_FILE}")" || -L "${EXCLUDE_FILE}" ]]; then
    echo "[!] ${EXCLUDE_FILE} goes through a symlink, not adding /.claudetanamo to it" >&2
  elif ! grep -qxF "/.claudetanamo" "${EXCLUDE_FILE}" 2>/dev/null; then
    echo "/.claudetanamo" >> "${EXCLUDE_FILE}"
  fi
fi

if [[ -f "${DEFAULTS_DIR}/CLAUDE.md" ]]; then
  cp "${DEFAULTS_DIR}/CLAUDE.md" "${STATE_DIR}/CLAUDE.md"
fi

# reseed the default skills
for skill in "${DEFAULTS_DIR}/skills/"*/; do
  [[ -d "${skill}" ]] || continue
  name="$(basename "${skill}")"
  rm -rf "${STATE_DIR}/skills/${name}"
  cp -R "${skill}" "${STATE_DIR}/skills/${name}"
done

# At a repo's top level the cell gets its own clone instead of the project, whose .git
# (config, hooks) host git would execute; the project itself is mounted read-only as the
# clone's origin. The host never runs git inside the clone once the cell has had it.
if [[ "$(git rev-parse --show-toplevel 2>/dev/null)" == "$(pwd -P)" ]]; then
  if [[ ! -d "${WORK_DIR}" ]]; then
    echo "[+] Cloning the project into the cell's workspace..."
    rm -rf "${WORK_DIR}.tmp"
    git clone --quiet --no-hardlinks "${PROJECT_ROOT}" "${WORK_DIR}.tmp"
    git -C "${WORK_DIR}.tmp" remote set-url origin /project
    mv "${WORK_DIR}.tmp" "${WORK_DIR}"
  fi
  WORKSPACE_MOUNTS=(
    -v "${WORK_DIR}":/workspace
    --mount "type=bind,source=${PROJECT_ROOT},target=/project,readonly"
  )
else
  WORKSPACE_MOUNTS=(-v "${PROJECT_ROOT}":/workspace)
fi

RUNTIME_ENV_FLAGS=()

# log in using api key
if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
  RUNTIME_ENV_FLAGS+=("-e" "ANTHROPIC_API_KEY")
fi

# verify the anchor exists in pf
if ! sudo pfctl -s Anchors 2>/dev/null | grep -q "claudetanamo"; then
  echo "[!] Loading perimeter rules into pfctl..."
  sudo pfctl -a claudetanamo -f /etc/pf.anchors/claudetanamo
fi

if ! sudo pfctl -s info 2>/dev/null | grep -q '^Status: Enabled'; then
  echo "[-] pf is disabled, run bin/setup.sh or 'sudo pfctl -e' first" >&2
  exit 1
fi

# create a temporary IPC directory to receive the guest IP upon boot
IPC_DIR="$(mktemp -d /tmp/claudetanamo.XXXXXX)"
IP_FILE="${IPC_DIR}/guest_ip"
# host-only record of the jailed IP, so cleanup doesn't trust the guest-writable file
JAILED_FILE="$(mktemp /tmp/claudetanamo-jailed.XXXXXX)"

cleanup() {
  local exit_code=$?
  local target_ip=""

  if [[ -s "${JAILED_FILE}" ]]; then
    target_ip="$(head -n1 "${JAILED_FILE}")"
  fi

  if [[ -n "${target_ip}" ]]; then
    printf "\n[+] Removing %s from pf jail...\n" "${target_ip}"
    sudo pfctl -a claudetanamo -t claudetanamo_inmates -T delete "${target_ip}" 2>/dev/null || true
  fi
  rm -rf "${IPC_DIR}" "${JAILED_FILE}"
  exit "${exit_code}"
}
trap cleanup EXIT INT TERM

# read the cell IP from the ipc file, jail it, and tell the cell it may start
jail_cell() {
  local ip=""

  for _ in {1..300}; do
    [[ -s "${IP_FILE}" ]] && ip="$(head -n1 "${IP_FILE}" | tr -d ' \r\n')"
    [[ -n "${ip}" ]] && break
    sleep 0.1
  done

  if [[ ! "${ip}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo "[-] No valid cell IP reported${ip:+ (got ${ip})}" >&2
    return 1
  fi
  printf "[+] Cell IP discovered: %s\n" "${ip}"
  echo "${ip}" > "${JAILED_FILE}"

  if ! sudo -n pfctl -a claudetanamo -t claudetanamo_inmates -T add "${ip}" >/dev/null 2>&1 ||
     ! sudo -n pfctl -a claudetanamo -t claudetanamo_inmates -T test "${ip}" >/dev/null 2>&1; then
    echo "[-] Could not add ${ip} to the pf jail" >&2
    return 1
  fi
  touch "${IPC_DIR}/jailed"
}

CONTAINER_LABEL="claudetanamo-$(date +%s)"

(
  if ! jail_cell; then
    echo "[-] Stopping ${CONTAINER_LABEL}" >&2
    container stop "${CONTAINER_LABEL}" >/dev/null 2>&1 || true
  fi
) &

echo "[+] Launching session (${CONTAINER_LABEL})..."

container run -it --rm \
  --name "${CONTAINER_LABEL}" \
  --user "$(id -u):$(id -g)" \
  --cap-drop=ALL \
  --cpus 4 \
  --memory 4g \
  "${WORKSPACE_MOUNTS[@]}" \
  -v "${STATE_DIR}":/home/prisoner/.claudetanamo \
  -v "${IPC_DIR}":/run/claudetanamo \
  -w /workspace \
  -e HOME=/home/prisoner \
  -e CLAUDE_CONFIG_DIR=/home/prisoner/.claudetanamo \
  -e TERM="${TERM:-xterm-256color}" \
  "${RUNTIME_ENV_FLAGS[@]}" \
  "${IMAGE_TAG}" \
  "$@"
