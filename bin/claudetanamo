#!/usr/bin/env bash
set -euo pipefail

SOURCE_BIN="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_BIN" ]]; do
  BIN_DIR="$(cd -P "$(dirname "$SOURCE_BIN")" && pwd)"
  SOURCE_BIN="$(readlink "$SOURCE_BIN")"
  [[ $SOURCE_BIN != /* ]] && SOURCE_BIN="$BIN_DIR/$SOURCE_BIN"
done
CLAUDETANAMO_REPO="$(cd -P "$(dirname "$SOURCE_BIN")/.." && pwd)"
DEFAULTS_DIR="${CLAUDETANAMO_REPO}/defaults"

PROJECT_ROOT="$(pwd)"
JAIL_DATA_DIR="${PROJECT_ROOT}/.claudetanamo"
IMAGE_TAG="claudetanamo:latest"

mkdir -p "${JAIL_DATA_DIR}/state/skills"
chmod 700 "${JAIL_DATA_DIR}"

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  GIT_DIR="$(git rev-parse --git-dir)"
  EXCLUDE_FILE="${GIT_DIR}/info/exclude"
  mkdir -p "$(dirname "${EXCLUDE_FILE}")"
  if ! grep -qxF "/.claudetanamo" "${EXCLUDE_FILE}" 2>/dev/null; then
    echo "/.claudetanamo" >> "${EXCLUDE_FILE}"
  fi
fi

if [[ -f "${DEFAULTS_DIR}/CLAUDE.md" ]]; then
  cp "${DEFAULTS_DIR}/CLAUDE.md" "${JAIL_DATA_DIR}/state/CLAUDE.md"
fi

if [[ -d "${DEFAULTS_DIR}/skills" ]]; then
  cp -rn "${DEFAULTS_DIR}/skills/"* "${JAIL_DATA_DIR}/state/skills/" 2>/dev/null || true
fi

RUNTIME_ENV_FLAGS=()

# log in using api key
if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
  RUNTIME_ENV_FLAGS+=("-e" "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}")
fi

# verify the anchor exists in pf
if ! sudo pfctl -s Anchors 2>/dev/null | grep -q "claudetanamo"; then
  echo "[!] Loading perimeter rules into pfctl..."
  sudo pfctl -a claudetanamo -f /etc/pf.anchors/claudetanamo
fi

if ! sudo pfctl -s info 2>/dev/null | grep -q '^Status: Enabled'; then
  echo "[-] pf is disabled, run bin/setup.sh or 'sudo pfctl -e' first" >&2
  exit 1
fi

# create a temporary IPC directory to receive the guest IP upon boot
IPC_DIR="$(mktemp -d /tmp/claudetanamo.XXXXXX)"
chmod 777 "${IPC_DIR}"
IP_FILE="${IPC_DIR}/guest_ip"
# host-only record of the jailed IP, so cleanup doesn't trust the guest-writable file
JAILED_FILE="$(mktemp /tmp/claudetanamo-jailed.XXXXXX)"

cleanup() {
  local exit_code=$?
  local target_ip=""

  if [[ -s "${JAILED_FILE}" ]]; then
    target_ip="$(head -n1 "${JAILED_FILE}")"
  fi

  if [[ -n "${target_ip}" ]]; then
    printf "\n[+] Removing %s from pf jail...\n" "${target_ip}"
    sudo pfctl -a claudetanamo -t claudetanamo_inmates -T delete "${target_ip}" 2>/dev/null || true
  fi
  rm -rf "${IPC_DIR}" "${JAILED_FILE}"
  exit "${exit_code}"
}
trap cleanup EXIT INT TERM

# read the cell IP from the ipc file, jail it, and tell the cell it may start
jail_cell() {
  local ip=""

  for _ in {1..300}; do
    [[ -s "${IP_FILE}" ]] && ip="$(head -n1 "${IP_FILE}" | tr -d ' \r\n')"
    [[ -n "${ip}" ]] && break
    sleep 0.1
  done

  if [[ ! "${ip}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo "[-] No valid cell IP reported${ip:+ (got ${ip})}" >&2
    return 1
  fi
  printf "[+] Cell IP discovered: %s\n" "${ip}"
  echo "${ip}" > "${JAILED_FILE}"

  if ! sudo -n pfctl -a claudetanamo -t claudetanamo_inmates -T add "${ip}" >/dev/null 2>&1 ||
     ! sudo -n pfctl -a claudetanamo -t claudetanamo_inmates -T test "${ip}" >/dev/null 2>&1; then
    echo "[-] Could not add ${ip} to the pf jail" >&2
    return 1
  fi
  touch "${IPC_DIR}/jailed"
}

CONTAINER_LABEL="claudetanamo-$(date +%s)"

(
  if ! jail_cell; then
    echo "[-] Stopping ${CONTAINER_LABEL}" >&2
    container stop "${CONTAINER_LABEL}" >/dev/null 2>&1 || true
  fi
) &

echo "[+] Launching session (${CONTAINER_LABEL})..."

container run -it --rm \
  --name "${CONTAINER_LABEL}" \
  --user "$(id -u):$(id -g)" \
  --cap-drop=ALL \
  --cpus 4 \
  --memory 4g \
  -v "${PROJECT_ROOT}":/workspace \
  -v "${IPC_DIR}":/run/claudetanamo \
  -v "${JAIL_DATA_DIR}/state/skills":/home/prisoner/.config/claude/skills \
  -w /workspace \
  -e HOME=/home/prisoner \
  -e CLAUDE_CONFIG_DIR=/workspace/.claudetanamo/state \
  -e TERM="${TERM:-xterm-256color}" \
  "${RUNTIME_ENV_FLAGS[@]}" \
  "${IMAGE_TAG}" \
  "$@"
